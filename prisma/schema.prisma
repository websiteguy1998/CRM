generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy, users & permissions
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  teams         Team[]
  companies     Company[]
  contacts      Contact[]
  leadSources   LeadSource[]
  campaigns     Campaign[]
  pipelines     Pipeline[]
  leads         Lead[]
  conversations Conversation[]
  calls         Call[]
  tasks         Task[]
  deals         Deal[]
  notes         Note[]
  activities    Activity[]
  tags          Tag[]
  integrations  IntegrationAccount[]
  templates     Template[]
}

enum Role {
  ADMIN
  MANAGER
  AGENT
  QA
  MARKETING
  LEAD_ENTRY
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(AGENT)
  // false = pending admin approval (self-signups start here); an
  // admin-created user (Settings -> Add user) starts true.
  active         Boolean  @default(true)
  // The Zoom account (usually their work email) this agent places
  // click-to-call calls from. Self-service — set from the Call tab.
  zoomUserEmail  String?
  // The Zoom Phone number assigned to zoomUserEmail in Zoom's own admin
  // panel. We don't set this — it's filled in automatically the first
  // time a synced call resolves this agent, purely for display (Settings
  // -> Users) so an admin can see the number-to-agent mapping.
  zoomPhoneNumber String?
  createdAt      DateTime @default(now())

  teamMemberships TeamMember[]
  ownedLeads      Lead[]        @relation("LeadOwner")
  createdLeads    Lead[]        @relation("LeadCreatedBy")
  assignedTasks   Task[]        @relation("TaskAssignee")
  calls           Call[]
  notes           Note[]
  activities      Activity[]
  stageChanges    LeadStageHistory[]
  sentMessages    Message[]
}

// Short-lived email verification code for the public signup flow. Not
// tied to a User row yet since the account isn't created until the code
// is confirmed.
model SignupVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String

  members TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

// ---------------------------------------------------------------------------
// Companies, contacts, leads
// ---------------------------------------------------------------------------

model Company {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  industry       String?
  website        String?
  city           String?
  state          String?
  country        String?
  createdAt      DateTime @default(now())

  contacts Contact[]
  leads    Lead[]
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now())

  leads Lead[]

  @@index([organizationId, phone])
  @@index([organizationId, email])
}

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String

  leads     Lead[]
  campaigns Campaign[]

  @@unique([organizationId, name])
}

model Campaign {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  sourceId       String?
  source         LeadSource? @relation(fields: [sourceId], references: [id])
  createdAt      DateTime    @default(now())

  leads Lead[]
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isDefault      Boolean  @default(false)

  stages PipelineStage[]
  leads  Lead[]
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  name       String
  order      Int
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)

  leads          Lead[]
  historyFrom    LeadStageHistory[] @relation("StageFrom")
  historyTo      LeadStageHistory[] @relation("StageTo")

  @@unique([pipelineId, order])
}

enum LeadStatus {
  OPEN
  WON
  LOST
  NURTURE
}

enum LeadCategory {
  WEB_DEVELOPMENT
  GRAPHIC_DESIGN
  UI_DESIGN
  SEO
  SMM
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id])
  sourceId       String?
  source         LeadSource?  @relation(fields: [sourceId], references: [id])
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id])
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  ownerId        String?
  owner          User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById    String?
  createdBy      User?        @relation("LeadCreatedBy", fields: [createdById], references: [id])
  status         LeadStatus   @default(OPEN)
  score          Int          @default(0)
  scoreReasons   Json?

  // Sheet-style fields (id name/url = the client's profile on the
  // platform they were found on, e.g. a Fiverr username + link).
  idName        String?
  idUrl         String?
  websiteUrl    String?
  // Country of the ID/profile (e.g. where the Fiverr account is based) —
  // distinct from clientCountry below, which is the client's own country.
  country       String?
  clientCountry String?
  deliveryDate  DateTime?
  price         Decimal?  @db.Decimal(12, 2)
  duration      String?
  statusNote    String?
  category      LeadCategory?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastActivityAt DateTime     @default(now())

  conversations Conversation[]
  calls         Call[]
  tasks         Task[]
  deals         Deal[]
  notes         Note[]
  activities    Activity[]
  stageHistory  LeadStageHistory[]
  tags          LeadTag[]

  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdById, createdAt])
  @@index([organizationId, websiteUrl])
}

model LeadStageHistory {
  id            String         @id @default(cuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id])
  fromStageId   String?
  fromStage     PipelineStage? @relation("StageFrom", fields: [fromStageId], references: [id])
  toStageId     String
  toStage       PipelineStage  @relation("StageTo", fields: [toStageId], references: [id])
  changedById   String?
  changedBy     User?          @relation(fields: [changedById], references: [id])
  changedAt     DateTime       @default(now())
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  color          String   @default("#6366f1")

  leads LeadTag[]

  @@unique([organizationId, name])
}

model LeadTag {
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([leadId, tagId])
}

// ---------------------------------------------------------------------------
// Unified communication: conversations / messages / calls
// ---------------------------------------------------------------------------

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  channel        Channel
  externalId     String?
  subject        String?
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())

  messages Message[]

  @@index([organizationId, channel])
  @@index([leadId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  status         MessageStatus     @default(SENT)
  body           String?
  mediaUrl       String?
  externalId     String?
  sentById       String?
  sentBy         User?             @relation(fields: [sentById], references: [id])
  openedAt       DateTime?
  createdAt      DateTime          @default(now())

  attachments Attachment[]
}

model Attachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id])
  url       String
  filename  String
  mimeType  String?
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  ANSWERED
  MISSED
  NO_ANSWER
  VOICEMAIL
}

model Call {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  agentId        String?
  agent          User?         @relation(fields: [agentId], references: [id])
  direction      CallDirection
  status         CallStatus
  fromNumber     String?
  toNumber       String?
  startedAt      DateTime      @default(now())
  durationSec    Int           @default(0)
  recordingUrl   String?
  // Zoom's per-leg call log "id" (distinct from externalId, which is the
  // shared call_id both legs report) — the recordings sub-resource
  // endpoint needs this specific id, not call_id.
  recordingLogId String?
  transcript     String?
  aiSummary      String?
  nextAction     String?
  externalId     String?

  @@index([organizationId, leadId])
}

// ---------------------------------------------------------------------------
// Tasks / follow-ups, deals, notes
// ---------------------------------------------------------------------------

enum TaskType {
  CALL
  EMAIL
  WHATSAPP
  SMS
  MEETING
  OTHER
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  type           TaskType     @default(OTHER)
  title          String
  notes          String?
  dueAt          DateTime
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, assignedToId, dueAt])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  title          String
  value          Decimal      @default(0) @db.Decimal(12, 2)
  currency       String       @default("USD")
  status         DealStatus   @default(OPEN)
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Unified activity timeline (the "golden record" feed)
// ---------------------------------------------------------------------------

enum ActivityType {
  LEAD_CREATED
  LEAD_ASSIGNED
  STAGE_CHANGED
  MESSAGE_INBOUND
  MESSAGE_OUTBOUND
  CALL_LOGGED
  TASK_CREATED
  TASK_COMPLETED
  NOTE_ADDED
  DEAL_UPDATED
  SCORE_UPDATED
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  type           ActivityType
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// Integrations & templates
// ---------------------------------------------------------------------------

enum IntegrationType {
  WHATSAPP
  ZOOM_PHONE
  GMAIL
  MICROSOFT_365
  SMS_TWILIO
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
}

model IntegrationAccount {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  type           IntegrationType
  name           String
  status         IntegrationStatus @default(NOT_CONFIGURED)
  config         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, type, name])
}

model Template {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  channel        Channel
  name           String
  body           String

  @@unique([organizationId, channel, name])
}
